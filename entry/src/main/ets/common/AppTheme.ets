/**
 * Visual constants tuned for small round/square wearable screens.
 * Dark background, high-contrast text, generous touch targets.
 */
export class AppTheme {
  static readonly BG: string = '#000000';
  static readonly CARD: string = '#1C1C1E';
  static readonly CARD_ACCENT: string = '#26303A';
  static readonly PRIMARY: string = '#0A84FF';
  static readonly GREEN: string = '#30D158';
  static readonly RED: string = '#FF453A';
  static readonly YELLOW: string = '#FFD60A';
  static readonly TEXT: string = '#FFFFFF';
  static readonly TEXT_DIM: string = '#9A9A9E';

  static readonly TITLE_FS: number = 19;
  static readonly BODY_FS: number = 15;
  static readonly SMALL_FS: number = 12;

  static readonly RADIUS: number = 22;
  static readonly GAP: number = 8;
  static readonly SCREEN_PAD: number = 14;
}
